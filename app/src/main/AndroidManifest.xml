<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <application android:label="Mod Menu" android:theme="@android:style/Theme.Material.Dark">
        <activity android:name="com.bonika.modmenu.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- هذا هو الـ Service الذي يُضاف أيضاً إلى Manifest اللعبة عند الحقن -->
        <service android:name="com.bonika.modmenu.FloatingService"
                 android:enabled="true" android:exported="false"
                 android:foregroundServiceType="specialUse"/>
    </application>
</manifest>
